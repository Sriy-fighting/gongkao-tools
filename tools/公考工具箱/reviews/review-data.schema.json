{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/review-data.schema.json",
  "title": "政治理论、常识与公基复盘资料库",
  "type": "object",
  "required": ["version", "questions"],
  "properties": {
    "version": {"const": 1},
    "libraryName": {"type": "string"},
    "exportedAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "backupAt": {"type": "string"},
    "dirty": {"type": "boolean"},
    "questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["key", "text"],
      "properties": {
        "key": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "sourceRef": {
      "type": "object",
      "required": ["file", "locator"],
      "properties": {
        "file": {"type": "string"},
        "locator": {"type": "string"},
        "excerpt": {"type": "string"},
        "asset": {"type": "string"},
        "crop": {
          "type": "object",
          "required": ["focusY"],
          "properties": {
            "focusY": {"type": "number", "minimum": 0, "maximum": 100},
            "label": {"type": "string"}
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "season", "subject", "number", "stem", "options", "answerStatus", "review", "tags", "match", "sourceRefs", "mastery", "reviewState"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "season": {"type": "string"},
        "subject": {"enum": ["政治理论", "常识", "公基"]},
        "number": {"type": ["integer", "string"]},
        "stem": {"type": "string"},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "answer": {"type": "string"},
        "answerStatus": {"enum": ["verified", "inferred", "pending"]},
        "review": {
          "type": "object",
          "required": ["summary", "analysis", "pitfalls", "memoryCue"],
          "properties": {
            "summary": {"type": "string"},
            "analysis": {"type": "string"},
            "pitfalls": {"type": "array", "items": {"type": "string"}},
            "memoryCue": {"type": "string"}
          }
        },
        "tags": {"type": "array", "items": {"type": "string"}},
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "match": {
          "type": "object",
          "required": ["status", "confidence", "evidence"],
          "properties": {
            "status": {"enum": ["verified", "pending", "unmatched"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}},
        "mastery": {"enum": ["new", "again", "fuzzy", "know"]},
        "reviewState": {
          "type": "object",
          "required": ["step", "nextReviewAt"],
          "properties": {
            "step": {"type": "integer", "minimum": 0},
            "nextReviewAt": {"type": ["string", "null"]},
            "history": {"type": "array"},
            "steps": {
              "type": "object",
              "properties": {
                "again": {"type": "integer", "minimum": 0, "maximum": 2},
                "fuzzy": {"type": "integer", "minimum": 0, "maximum": 2},
                "know": {"type": "integer", "minimum": 0, "maximum": 2}
              }
            }
          }
        },
        "note": {"type": "string"}
      }
    }
  }
}
